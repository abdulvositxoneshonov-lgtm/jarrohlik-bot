# ==== Mijozlar boti (bot.py) ====
TELEGRAM_BOT_TOKEN=your_customer_bot_token_here
CHANNEL_ID=-1000000000000

# ==== Admin boti (admin_bot.py) ====
ADMIN_BOT_TOKEN=your_admin_bot_token_here
# Vergul bilan ajratilgan Telegram user ID'lar (admin panelidan foydalana oladiganlar)
ADMIN_IDS=123456789,987654321

# ==== Umumiy baza (ikkala bot ham shu faylni ishlatadi) ====
DATABASE_URL=sqlite:///bot.db

# ==== Majburiy guruh a'zoligi (ixtiyoriy — ikkalasi ham bo'sh bo'lsa, tekshiruv o'chirilgan hisoblanadi) ====
REQUIRED_GROUP_ID=-1000000000000
REQUIRED_GROUP_LINK=https://t.me/your_group_link

# ==== Vaqt zonasi — operator kiritgan qabul sanasi shu zonada talqin qilinadi (eslatmalar uchun) ====
TIMEZONE=Asia/Tashkent

# ==== Mijoz o'zi vaqt tanlashi (ish jadvali) ====
# Ish kunlari: 1=Dushanba ... 7=Yakshanba
WORK_DAYS=1,2,3,4,5,6
WORK_START=09:00
WORK_END=18:00
# Bitta qabul davomiyligi (daqiqa) va necha kun oldinga yozilish mumkin
SLOT_MINUTES=60
BOOKING_DAYS_AHEAD=7
# Hozirgi vaqtdan kamida necha daqiqa keyingi vaqtlarni ko'rsatish
MIN_LEAD_MINUTES=60
# Bitta xizmat uchun bir vaqtda nechta mijoz qabul qilinadi
SLOT_CAPACITY=1

# ==== Kunlik hisobot (operatorlar guruhiga) — bo'sh qoldirilsa o'chiriladi ====
DAILY_REPORT_TIME=08:00

# ==== Referral bonusi: har N ta ro'yxatdan o'tgan do'st uchun X% chegirma promo-kodi (0 = o'chirilgan) ====
REFERRAL_BONUS_EVERY=3
REFERRAL_BONUS_PERCENT=10
