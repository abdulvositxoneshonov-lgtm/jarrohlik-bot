# ==== Mijozlar boti (bot.py) ====
TELEGRAM_BOT_TOKEN=your_customer_bot_token_here
CHANNEL_ID=-1000000000000

# ==== Admin boti (admin_bot.py) ====
ADMIN_BOT_TOKEN=your_admin_bot_token_here
# Vergul bilan ajratilgan Telegram user ID'lar (admin panelidan foydalana oladiganlar)
ADMIN_IDS=123456789,987654321

# ==== Umumiy baza (ikkala bot ham shu faylni ishlatadi) ====
DATABASE_URL=sqlite:///bot.db

# ==== Majburiy guruh a'zoligi (ixtiyoriy — ikkalasi ham bo'sh bo'lsa, tekshiruv o'chirilgan hisoblanadi) ====
REQUIRED_GROUP_ID=-1000000000000
REQUIRED_GROUP_LINK=https://t.me/your_group_link
